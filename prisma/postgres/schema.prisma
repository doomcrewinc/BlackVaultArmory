  // HMAC-SHA256 fingerprint of the plaintext serial, for equality lookups
  // without decrypting every row. null until the encryption migration runs.
  serialNumberHash String?  @unique
  // FirearmType: PISTOL | RIFLE | SHOTGUN | SMG | PCC | PDW | REVOLVER | BOLT_ACTION | LEVER_ACTION
  type            String
  // NfaClass: NONE | SBR | SBS | MACHINE_GUN | AOW | DESTRUCTIVE_DEVICE
  // How the firearm is regulated — independent of `type`. A select-fire
  // pistol, PDW or rifle is all MACHINE_GUN. Defaults to NONE: nothing infers
  // a legal classification from existing data.
  nfaClass        String   @default("NONE")
  // MgRegistry: TRANSFERABLE | PRE_SAMPLE | POST_SAMPLE
  // Only meaningful when nfaClass = MACHINE_GUN; cleared server-side otherwise.
  mgRegistry      String?
  // NFA paperwork. All nullable, and cleared server-side when nfaClass is NONE
  // or the transfer method is FORM_4473 (a 4473 transfer has no stamp).
  // NfaTransferMethod: FORM_1 | FORM_3 | FORM_4 | FORM_4473 | OTHER
  // Encrypted at rest (ENCRYPTED_FIELDS). nfaApprovalDate/nfaTaxPaid are
  // type-changed from DateTime/Float to String so ciphertext can live in
  // them; the encryption extension (Task 3) restores Date/number to app code.
  nfaTransferMethod String?
  nfaControlNumber  String?
  nfaApprovalDate   String?
  nfaTaxPaid        String?
  nfaRegisteredTo   String?
  acquisitionDate DateTime
  purchasePrice   Float?
  currentValue    Float?
  notes           String?
  imageUrl        String?
  // imageSource: "uploaded" | "google_cse" | "seed" | "url"
  imageSource     String?

  // Maintenance tracking
  lastMaintenanceDate DateTime?
  maintenanceIntervalDays Int?

  builds           Build[]
  rangeSessions    RangeSession[]
  documents        Document[]
  maintenanceLogs  MaintenanceLog[]
  kitItems         KitItem[]
  photos           Photo[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([caliber])
  @@index([type])
  @@index([nfaClass])
}

