// ─── DATE NORMALIZATION AUDIT ─────────────────────────────────
// Records every legacy date-only value before the migration changes it, so the
// migration is reversible and can be re-run with a corrected timezone.
// No foreign keys: an audit row must outlive the record it describes.

model DateNormalizationAudit {
  id            String   @id @default(cuid())
  model         String
  field         String
  recordId      String
  originalValue DateTime
  appliedValue  DateTime
  appliedZone   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([model, field, recordId])
  @@index([model, field])
}

// ─── ACCOUNTS ─────────────────────────────────────────────────
// See docs/superpowers/specs/2026-09-27-accounts-design.md. Users are never
// hard-deleted: the audit log (spec 2b) must still name a disabled user.
//
// Role and AuthTokenKind are "enums" in the design spec, but this schema is
// text-substituted for both providers (see src/lib/db/schema-codegen.ts) and
// SQLite has no native enum support, so — same convention as every other
// enum-like column here (Firearm.type, Firearm.nfaClass, Accessory.type,
// etc.) — they are String columns with the value set documented in a comment.
// The matching TS unions live in src/lib/accounts.ts.

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  displayName  String
  passwordHash String
  // Role: ADMIN | USER
  role         String       @default("USER")
  disabledAt   DateTime?
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  resetTokens  AuthToken[]  @relation("TokenUser")
  issuedTokens AuthToken[]  @relation("TokenIssuer")
  auditEvents  AuditEvent[]
  capturePasses CapturePass[] @relation("CapturePassIssuer")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  capturePasses CapturePass[]

  @@index([userId])
}

model AuthToken {
  id          String    @id @default(cuid())
  // AuthTokenKind: INVITE | RESET | SETUP
  kind        String
  tokenHash   String    @unique
  userId      String?
  user        User?     @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)
  // Role: ADMIN | USER — set only when kind = INVITE (the role granted on redemption).
  role        String?
  createdById String?
  createdBy   User?     @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  usedAt      DateTime?

  @@index([kind, usedAt])
}

// ─── SETTINGS ─────────────────────────────────────────────────

model AppSettings {
  id                      String   @id @default("singleton")
  googleCseApiKey         String?
  googleCseSearchEngineId String?
  enableImageSearch       Boolean  @default(false)
  includeUploadsInBackup  Boolean  @default(true)
  autoBackupEnabled       Boolean  @default(false)
  autoBackupCadence       String   @default("weekly")
  backupDestinationPath   String?
  manualLanHost           String?
  defaultCurrency         String   @default("USD")
  defaultAmmoAlertThreshold Int?
  // Days ahead to warn that a supply is expiring. One fixed window would be
  // wrong for both milk and body armor, so it is a setting. null = use the
  // default in src/lib/supply.ts.
  expiryWarningDays       Int?
  // IANA timezone, e.g. "America/Denver". null = unset.
  // Used to convert legacy date-only instants to the day their author meant.
  timezone                String?
  // Whether http://<ip>:<port> (bypassing the reverse proxy) is served.
  // null = never decided: the first boot seeds it from DIRECT_ACCESS_INITIAL
  // (installers write it) and a fresh install lands on false. See
  // docs/superpowers/specs/2026-09-26-public-url-and-direct-access-design.md.
  allowDirectAccess       Boolean?
  // Ciphertext of the fixed string "blackvault-key-check" (AAD
  // "AppSettings.encryptionKeyCheck"), created on the first run that has a
  // key. Lets startup detect a wrong or lost encryption key before touching
  // any encrypted row. null = encryption not yet enabled on this install.
  encryptionKeyCheck      String?
  // true = a committed encryption migration or key rotation left old values
  // (plaintext, or old-key ciphertext) in the database's free space, and the
  // compaction that erases them (VACUUM / VACUUM FULL) has not succeeded yet.
  // Set in the same transaction as the rewrite; every start retries the
  // compaction while it is true, then clears it (src/lib/encryption/startup.ts).
  encryptionCompactionPending Boolean @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ─── KITS ─────────────────────────────────────────────────────
// A kit is a container, not a copy: a KitItem points at an inventory record
// and says how much of it lives in this kit. See the item-categories spec,
// "Kit and KitItem: what is packed where".

model Kit {
  id        String    @id @default(cuid())
  name      String
  // KitCategory: BUGOUT | MEDICAL | RANGE | VEHICLE | HOME | OTHER
  category  String
  location  String?
  notes     String?
  imageUrl  String?
  items     KitItem[]
  documents Document[]
  photos    Photo[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category])
}

// ─── AUDIT LOG ────────────────────────────────────────────────
// Append-only. See docs/superpowers/specs/2026-09-29-audit-log-design.md.
model AuditEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName   String
  actorIp     String?
  // Type: AuditAction (src/lib/audit/actions.ts)
  action      String
  entityType  String?
  entityId    String?
  entityLabel String?
  // JSON text
  changes     String?

  @@index([at])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

model KitItem {
  id             String      @id @default(cuid())
  kitId          String
  kit            Kit         @relation(fields: [kitId], references: [id], onDelete: Cascade)

  // Exactly one source, or none plus a label. Enforced in the API and by test.
  gearId         String?
  supplyId       String?
  accessoryId    String?
  ammoStockId    String?
  firearmId      String?
  label          String?

  gear           Gear?       @relation(fields: [gearId], references: [id], onDelete: Cascade)
  supply         Supply?     @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  accessory      Accessory?  @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  ammoStock      AmmoStock?  @relation(fields: [ammoStockId], references: [id], onDelete: Cascade)
  firearm        Firearm?    @relation(fields: [firearmId], references: [id], onDelete: Cascade)

  quantity       Float       @default(1)
  targetQuantity Float?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([kitId])
}

// ─── PHOTOS ───────────────────────────────────────────────────
// A gallery picture. Exactly one owner column is set; src/lib/photos/owner.ts
// is the only code that chooses it. The file is
// <uploadsRoot>/images/photos/<fileName>, its preview
// <uploadsRoot>/images/photos/thumbs/<id>.webp.
model Photo {
  id          String     @id @default(cuid())
  fileName    String     @unique
  mimeType    String
  fileSize    Int
  width       Int
  height      Int
  label       String?
  firearmId   String?
  accessoryId String?
  gearId      String?
  kitId       String?
  ammoStockId String?
  supplyId    String?
  firearm     Firearm?   @relation(fields: [firearmId], references: [id], onDelete: Cascade)
  accessory   Accessory? @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  gear        Gear?      @relation(fields: [gearId], references: [id], onDelete: Cascade)
  kit         Kit?       @relation(fields: [kitId], references: [id], onDelete: Cascade)
  ammoStock   AmmoStock? @relation(fields: [ammoStockId], references: [id], onDelete: Cascade)
  supply      Supply?    @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  // The account that added it. No relation: accounts are not in backups.
  createdById String?
  viaPass     Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([firearmId])
  @@index([accessoryId])
  @@index([gearId])
  @@index([kitId])
  @@index([ammoStockId])
  @@index([supplyId])
}

// A short-lived, upload-only pass for one item, opened from a signed-in
// session and used by a phone with no session. Only the token's hash is stored.
model CapturePass {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  entityType  String
  entityId    String
  createdById String
  createdBy   User      @relation("CapturePassIssuer", fields: [createdById], references: [id], onDelete: Cascade)
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  closedAt    DateTime?
  uploadCount Int       @default(0)

  @@index([entityType, entityId])
}
