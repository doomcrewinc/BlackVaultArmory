  id            String   @id @default(cuid())
  model         String
  field         String
  recordId      String
  originalValue DateTime
  appliedValue  DateTime
  appliedZone   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([model, field, recordId])
  @@index([model, field])
}

