# BlackVault configuration
# Copy this file to .env (or let install.sh / install.bat generate it) and adjust as needed.
# Start and stop BlackVault with plain `docker compose up -d` / `docker compose down`
# for either database: the lines below decide which one runs.

# Directory where BlackVault stores its database and uploaded images.
# Default is ./data (relative to the project folder).
# Use an absolute path (e.g. /home/yourname/.blackvault) if you prefer.
DATA_DIR=./data

# Port to expose BlackVault on.
PORT=3000

# ── Public URL, reverse proxy and direct access ─────────────────────────
# Required. The one address people use to reach BlackVault, normally your
# reverse proxy's HTTPS address. The container will not start without it.
# install.sh / install.bat and update.sh / update.bat prompt for it.
# BlackVault has accounts but no two-factor authentication — see "Running
# behind a reverse proxy" in README.md before making this address reachable
# beyond a network you trust.
BLACKVAULT_PUBLIC_URL=https://vault.example.com

# IPs, CIDR ranges or host names your reverse proxy connects from,
# comma-separated (e.g. 172.28.0.0/16). With direct access off, connections
# from anything else are reset. Leave blank if you have no proxy yet.
# BLACKVAULT_TRUSTED_PROXIES=172.28.0.0/16

# Break-glass: force direct-access-by-IP on regardless of the stored
# setting. Only "true" has any effect. See "Running behind a reverse proxy"
# in README.md.
# BLACKVAULT_ALLOW_DIRECT_ACCESS=true

# Seeds the stored direct-access setting on first startup only (ignored
# after that). Only "on" (case-insensitive) seeds it true; anything else,
# including blank, seeds it false. install.sh / install.bat and
# update.sh / update.bat write this for you — you shouldn't need to set it
# by hand.
# BLACKVAULT_DIRECT_ACCESS_INITIAL=on

# ── Database ────────────────────────────────────────────────────────────
# SQLite (single file, single container): leave the four PostgreSQL lines
# below commented out. That is the default when none of them are set, and it
# is what every install made before PostgreSQL support uses.
#
# PostgreSQL (what install.sh sets up for new installs): uncomment all four.
#   COMPOSE_PROFILES=postgres             starts the database container
#   BLACKVAULT_DB_PROVIDER=postgres       tells BlackVault to use it
#   BLACKVAULT_POSTGRES_PASSWORD          generate one with: openssl rand -hex 24
#   BLACKVAULT_DATABASE_URL               the same password, written into the URL
# The password is hex, so it can go into the URL as-is.
# The names start with BLACKVAULT_ on purpose: Docker Compose lets a variable
# exported in your shell override .env, and plain DATABASE_URL is one many
# developer machines export. Do not use DATABASE_URL / DB_PROVIDER /
# POSTGRES_PASSWORD here; docker-compose.yml ignores them.
# Moving existing SQLite data? Don't edit these by hand: follow "Moving from
# SQLite to PostgreSQL" in README.md; the migration tool writes them for you.
#
# COMPOSE_PROFILES=postgres
# BLACKVAULT_DB_PROVIDER=postgres
# BLACKVAULT_POSTGRES_PASSWORD=<48 hex characters>
# BLACKVAULT_DATABASE_URL=postgresql://blackvault:<same password>@db:5432/blackvault
