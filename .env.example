# BlackVault configuration
# Copy this file to .env (or let install.sh generate it) and adjust as needed.

# Directory where BlackVault stores its database and uploaded images.
# Default is ./data (relative to the project folder).
# Use an absolute path (e.g. /home/yourname/.blackvault) if you prefer.
DATA_DIR=./data

# Port to expose BlackVault on.
PORT=3000

# Database engine: postgres (default, recommended) or sqlite.
# postgres -> docker compose up -d
# sqlite   -> docker compose -f docker-compose.sqlite.yml up -d
DB_PROVIDER=postgres

# PostgreSQL password (required when DB_PROVIDER=postgres). install.sh generates one.
# Generate your own with: openssl rand -hex 24
POSTGRES_PASSWORD=
